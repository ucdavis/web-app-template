{
  "name": "web-app-template",
  "private": true,
  "scripts": {
    "db:up": "docker compose -p web-app-template_devcontainer -f .devcontainer/docker-compose.yml up -d sql",
    "db:down": "docker compose -p web-app-template_devcontainer -f .devcontainer/docker-compose.yml stop sql",
    "db:logs": "docker compose -p web-app-template_devcontainer -f .devcontainer/docker-compose.yml logs -f sql",
    "deployment-settings:sync": "node scripts/sync-deployment-settings.mts --write",
    "deployment-settings:check": "npm run deployment-settings:typecheck && node scripts/sync-deployment-settings.mts --check",
    "deployment-settings:typecheck": "tsc -p tsconfig.scripts.json --noEmit",
    "start": "npm-run-all --parallel start:server start:client:when-server-ready",
    "start:server": "dotnet watch run --project server/server.csproj --launch-profile http-cli",
    "start:client": "cd client && npm run dev:open",
    "start:client:debug": "wait-on http-get://127.0.0.1:5165/health && cd client && npm run dev",
    "start:client:when-server-ready": "wait-on http-get://127.0.0.1:5165/health && npm run start:client"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@ucdavis/gunrock-tailwind": "^2.6.0"
  }
}
