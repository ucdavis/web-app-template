{
  "$schema": "./deployment-settings.schema.json",
  "version": 1,
  "settings": [
    {
      "id": "auth-callback-path",
      "githubName": "AUTH_CALLBACK_PATH",
      "classification": "variable",
      "valueType": "string",
      "description": "OpenID Connect callback path used by Microsoft Identity Web.",
      "requiredWhen": "never",
      "appServiceName": "Auth__CallbackPath",
      "bicep": {
        "enabled": true,
        "paramName": "authCallbackPath",
        "default": "/signin-oidc",
        "computeParam": true
      }
    },
    {
      "id": "auth-client-id",
      "githubName": "AUTH_CLIENT_ID",
      "classification": "variable",
      "valueType": "string",
      "description": "Entra ID application client ID used by Microsoft Identity Web.",
      "requiredWhen": "never",
      "appServiceName": "Auth__ClientId",
      "bicep": {
        "enabled": true,
        "paramName": "authClientId",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "auth-domain",
      "githubName": "AUTH_DOMAIN",
      "classification": "variable",
      "valueType": "string",
      "description": "Entra ID domain used by Microsoft Identity Web.",
      "requiredWhen": "never",
      "appServiceName": "Auth__Domain",
      "bicep": {
        "enabled": true,
        "paramName": "authDomain",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "auth-instance",
      "githubName": "AUTH_INSTANCE",
      "classification": "variable",
      "valueType": "string",
      "description": "Entra ID authority instance used by Microsoft Identity Web.",
      "requiredWhen": "never",
      "appServiceName": "Auth__Instance",
      "bicep": {
        "enabled": true,
        "paramName": "authInstance",
        "default": {
          "expression": "environment().authentication.loginEndpoint"
        },
        "computeParam": true
      }
    },
    {
      "id": "auth-tenant-id",
      "githubName": "AUTH_TENANT_ID",
      "classification": "variable",
      "valueType": "string",
      "description": "Entra ID tenant ID used by Microsoft Identity Web.",
      "requiredWhen": "never",
      "appServiceName": "Auth__TenantId",
      "bicep": {
        "enabled": true,
        "paramName": "authTenantId",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "notification-base-url",
      "githubName": "NOTIFICATION_BASE_URL",
      "classification": "variable",
      "valueType": "string",
      "description": "Base URL used in generated notification emails. Defaults to the App Service hostname.",
      "requiredWhen": "never",
      "appServiceName": "Notification__BaseUrl",
      "bicep": {
        "enabled": true,
        "paramName": "notificationBaseUrl",
        "default": "",
        "computeParam": true,
        "moduleValueExpression": "resolvedNotificationBaseUrl"
      }
    },
    {
      "id": "notification-default-app-name",
      "githubName": "NOTIFICATION_DEFAULT_APP_NAME",
      "classification": "variable",
      "valueType": "string",
      "description": "Default application name used in generated notifications.",
      "requiredWhen": "never",
      "appServiceName": "Notification__DefaultAppName",
      "bicep": {
        "enabled": true,
        "paramName": "notificationDefaultAppName",
        "default": {
          "expression": "appName"
        },
        "computeParam": true
      }
    },
    {
      "id": "notification-default-button-text",
      "githubName": "NOTIFICATION_DEFAULT_BUTTON_TEXT",
      "classification": "variable",
      "valueType": "string",
      "description": "Default button text used in generated notifications.",
      "requiredWhen": "never",
      "appServiceName": "Notification__DefaultButtonText",
      "bicep": {
        "enabled": true,
        "paramName": "notificationDefaultButtonText",
        "default": "Open the application",
        "computeParam": true
      }
    },
    {
      "id": "otel-exporter-otlp-endpoint",
      "githubName": "OTEL_EXPORTER_OTLP_ENDPOINT",
      "classification": "variable",
      "valueType": "string",
      "description": "Optional OTLP exporter endpoint. Leave empty when no external OTLP collector is configured.",
      "requiredWhen": "never",
      "appServiceName": "OTEL_EXPORTER_OTLP_ENDPOINT",
      "bicep": {
        "enabled": true,
        "paramName": "otelExporterOtlpEndpoint",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "otel-exporter-otlp-headers",
      "githubName": "OTEL_EXPORTER_OTLP_HEADERS",
      "classification": "secret",
      "valueType": "string",
      "description": "Optional OTLP exporter headers, such as collector authorization.",
      "requiredWhen": "never",
      "appServiceName": "OTEL_EXPORTER_OTLP_HEADERS",
      "bicep": {
        "enabled": true,
        "paramName": "otelExporterOtlpHeaders",
        "secure": true,
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "otel-exporter-otlp-protocol",
      "githubName": "OTEL_EXPORTER_OTLP_PROTOCOL",
      "classification": "variable",
      "valueType": "string",
      "description": "OTLP exporter protocol used when an OTLP endpoint is configured.",
      "requiredWhen": "never",
      "appServiceName": "OTEL_EXPORTER_OTLP_PROTOCOL",
      "appServiceConditionParam": "otelExporterOtlpEndpoint",
      "bicep": {
        "enabled": true,
        "paramName": "otelExporterOtlpProtocol",
        "default": "http/protobuf",
        "allowed": ["grpc", "http/protobuf"],
        "computeParam": true
      }
    },
    {
      "id": "otel-resource-attributes",
      "githubName": "OTEL_RESOURCE_ATTRIBUTES",
      "classification": "variable",
      "valueType": "string",
      "description": "Optional OpenTelemetry resource attributes.",
      "requiredWhen": "never",
      "appServiceName": "OTEL_RESOURCE_ATTRIBUTES",
      "bicep": {
        "enabled": true,
        "paramName": "otelResourceAttributes",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "otel-service-name",
      "githubName": "OTEL_SERVICE_NAME",
      "classification": "variable",
      "valueType": "string",
      "description": "Optional OpenTelemetry service name.",
      "requiredWhen": "never",
      "appServiceName": "OTEL_SERVICE_NAME",
      "bicep": {
        "enabled": true,
        "paramName": "otelServiceName",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "smtp-bcc-email",
      "githubName": "SMTP_BCC_EMAIL",
      "classification": "variable",
      "valueType": "string",
      "description": "BCC email address for outbound email.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__BccEmail",
      "bicep": {
        "enabled": true,
        "paramName": "smtpBccEmail",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "smtp-from-email",
      "githubName": "SMTP_FROM_EMAIL",
      "classification": "variable",
      "valueType": "string",
      "description": "From email address for outbound email.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__FromEmail",
      "bicep": {
        "enabled": true,
        "paramName": "smtpFromEmail",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "smtp-from-name",
      "githubName": "SMTP_FROM_NAME",
      "classification": "variable",
      "valueType": "string",
      "description": "From display name for outbound email.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__FromName",
      "bicep": {
        "enabled": true,
        "paramName": "smtpFromName",
        "default": {
          "expression": "appName"
        },
        "computeParam": true
      }
    },
    {
      "id": "smtp-host",
      "githubName": "SMTP_HOST",
      "classification": "variable",
      "valueType": "string",
      "description": "SMTP host for outbound email.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__Host",
      "bicep": {
        "enabled": true,
        "paramName": "smtpHost",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "smtp-password",
      "githubName": "SMTP_PASSWORD",
      "classification": "secret",
      "valueType": "string",
      "description": "Optional SMTP password runtime setting.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__Password",
      "bicep": {
        "enabled": true,
        "paramName": "smtpPassword",
        "secure": true,
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "smtp-port",
      "githubName": "SMTP_PORT",
      "classification": "variable",
      "valueType": "int",
      "description": "SMTP port for outbound email.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__Port",
      "bicep": {
        "enabled": true,
        "paramName": "smtpPort",
        "default": 587,
        "computeParam": true
      }
    },
    {
      "id": "smtp-reply-to-email",
      "githubName": "SMTP_REPLY_TO_EMAIL",
      "classification": "variable",
      "valueType": "string",
      "description": "Reply-to email address for outbound email.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__ReplyToEmail",
      "bicep": {
        "enabled": true,
        "paramName": "smtpReplyToEmail",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "smtp-timeout",
      "githubName": "SMTP_TIMEOUT",
      "classification": "variable",
      "valueType": "int",
      "description": "SMTP timeout in milliseconds.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__Timeout",
      "bicep": {
        "enabled": true,
        "paramName": "smtpTimeout",
        "default": 100000,
        "computeParam": true
      }
    },
    {
      "id": "smtp-username",
      "githubName": "SMTP_USERNAME",
      "classification": "variable",
      "valueType": "string",
      "description": "SMTP username for outbound email.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__Username",
      "bicep": {
        "enabled": true,
        "paramName": "smtpUsername",
        "default": "",
        "computeParam": true
      }
    },
    {
      "id": "smtp-use-ssl",
      "githubName": "SMTP_USE_SSL",
      "classification": "variable",
      "valueType": "bool",
      "description": "Whether SMTP should use SSL.",
      "requiredWhen": "never",
      "appServiceName": "Smtp__UseSsl",
      "bicep": {
        "enabled": true,
        "paramName": "smtpUseSsl",
        "default": true,
        "computeParam": true
      }
    },
    {
      "id": "sql-admin-login",
      "githubName": "SQL_ADMIN_LOGIN",
      "classification": "variable",
      "valueType": "string",
      "description": "SQL admin login for SQL authentication.",
      "requiredWhen": "never",
      "githubDefault": "sqladmin",
      "bicep": {
        "enabled": true,
        "paramName": "sqlAdminLogin"
      }
    },
    {
      "id": "sql-admin-password",
      "githubName": "SQL_ADMIN_PASSWORD",
      "classification": "secret",
      "valueType": "string",
      "description": "SQL admin password used when deploy_infra is true.",
      "requiredWhen": "deploy_infra",
      "bicep": {
        "enabled": true,
        "paramName": "sqlAdminPassword",
        "secure": true
      }
    },
    {
      "id": "sql-database-name",
      "githubName": "SQL_DATABASE_NAME",
      "classification": "variable",
      "valueType": "string",
      "description": "SQL database name.",
      "requiredWhen": "never",
      "bicep": {
        "enabled": true,
        "paramName": "sqlDatabaseName",
        "default": {
          "expression": "appName"
        }
      }
    },
    {
      "id": "sql-sku-name",
      "githubName": "SQL_SKU_NAME",
      "classification": "variable",
      "valueType": "string",
      "description": "SQL database SKU name.",
      "requiredWhen": "never",
      "bicep": {
        "enabled": true,
        "paramName": "sqlSkuName",
        "default": {
          "expression": "env == 'prod' ? 'S0' : 'Basic'"
        }
      }
    },
    {
      "id": "sql-sku-tier",
      "githubName": "SQL_SKU_TIER",
      "classification": "variable",
      "valueType": "string",
      "description": "SQL database SKU tier.",
      "requiredWhen": "never",
      "bicep": {
        "enabled": true,
        "paramName": "sqlSkuTier",
        "default": {
          "expression": "env == 'prod' ? 'Standard' : 'Basic'"
        }
      }
    },
    {
      "id": "web-sku-name",
      "githubName": "WEB_SKU_NAME",
      "classification": "variable",
      "valueType": "string",
      "description": "App Service plan SKU name.",
      "requiredWhen": "never",
      "bicep": {
        "enabled": true,
        "paramName": "webSkuName",
        "default": {
          "expression": "env == 'prod' ? 'B1' : 'B1'"
        },
        "computeParam": true
      }
    },
    {
      "id": "web-sku-tier",
      "githubName": "WEB_SKU_TIER",
      "classification": "variable",
      "valueType": "string",
      "description": "App Service plan SKU tier.",
      "requiredWhen": "never",
      "bicep": {
        "enabled": true,
        "paramName": "webSkuTier",
        "default": {
          "expression": "env == 'prod' ? 'Basic' : 'Basic'"
        },
        "computeParam": true
      }
    }
  ]
}
